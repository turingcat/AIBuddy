{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heybuddy.invalid/rebrand/map.schema.json",
  "title": "HeyBuddy bounded rebrand rule map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[\\]])(?!.*(^|/)\\.{1,2}($|/))[^:]+$"
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths", "boundary"],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/safePath"
              }
            },
            "boundary": {
              "enum": ["token", "literal"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": {
              "const": "path"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/safePath"
              }
            }
          }
        }
      ]
    },
    "commonRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "selector", "from", "reason", "appliesTo"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "preserve": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["upstream", "product"]
          }
        },
        "expectedMatches": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rule": {
      "allOf": [
        {
          "$ref": "#/$defs/commonRule"
        },
        {
          "oneOf": [
            {
              "required": ["to"],
              "not": {
                "required": ["preserve"]
              }
            },
            {
              "required": ["preserve"],
              "not": {
                "required": ["to"]
              }
            }
          ]
        }
      ]
    }
  }
}
